  "cards": [
    {
      "dot": "rose",
      "title": "Availability first",
      "items": [
        "Disabled, cooling-down, model-ineligible, and hard-reserved credentials never enter the pipeline",
        "Soft reserve levels 1-3 only rank the pool, and only when reserves is a slot"
      ]
    },
    {
      "dot": "cyan",
      "title": "Slots",
      "items": [
        "Narrowing criteria keep the best group: priority, reserves, earliest-reset, most-remaining",
        "A picker as primary makes tiebreak inactive; an empty tiebreak means round-robin"
      ]
    },
    {
      "dot": "amber",
      "title": "Legacy strategy",
      "items": [
        "Without routing.selection the shared selection is {reserves, strategy}",
        "Manual priority applies only when priority is one of the slots"
      ]
    }
  ]
