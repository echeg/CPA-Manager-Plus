  "edges": [
    {
      "from": "candidates",
      "to": "available"
    },
    {
      "from": "available",
      "to": "preferred",
      "label": "available set"
    },
    {
      "from": "available",
      "to": "none",
      "label": "empty",
      "role": "error",
      "variant": "security"
    },
    {
      "from": "preferred",
      "to": "selected",
      "label": "usable → taken",
      "role": "branch",
      "variant": "emphasis"
    },
    {
      "from": "preferred",
      "to": "primary",
      "label": "unset or unavailable"
    },
    {
      "from": "primary",
      "to": "tiebreak",
      "label": "best group"
    },
    {
      "from": "tiebreak",
